#include <iostream>
using namespace std;
int main(){
     int k;
     cin>>k;
     while(k--){
          int a,b,c;
          cin>>a>>b>>c;
          int half = abs(a - b);
          int n = 2 * half;
          if (a > n || b > n || c > n) {
              cout << -1 << "
";
          } else {
              int d = (c > half) ? (c - half) : (c + half);
              cout << d << "
";
          }
     }
     return 0;
}