#include <iostream>
#include <algorithm>
using namespace std;
 
int main() {
    int n ;
    cin>>n;
    while(n--){
        int sum=0;
        int a;
        cin>>a;
        while(a>0){
            int d =a%10;
            sum+=d;
            a/=10;
 
        }
        cout<<sum<<endl;
        
        
    }
    return 0;
 
}