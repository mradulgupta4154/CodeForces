#include <iostream>
#include <vector>
#include<algorithm>
using namespace std;
int main() {
    int t;
    cin >> t;
    while(t--){
        string s;
        cin>>s;
        int n =s.length();
        string c=s.substr(0,n/2);
        string d=s.substr(n/2,n);
        if(c==d){
            cout<<"YES"<<endl;
        }
        else{
            cout<<"NO"<<endl;
        }
    }
 
    return 0;
}