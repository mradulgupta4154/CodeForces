#include <iostream>
#include <algorithm>
#include<vector>
using namespace std;
 
int main() {
    int n;
    cin>>n;
    while(n--){
        int a,k;
        cin>>a>>k;
        vector<int>vec;
        for(int i =0;i<a;i++){
            int b;
            cin>>b;
            vec.push_back(b);
        }
        bool found=false;
        for(int i =0;i<a;i++){
            if(vec[i]==k){
                found=true;
            }
        }
        if(found) cout<<"YES"<<endl;
        else cout<<"NO"<<endl;
    }
    
    return 0;
 
}