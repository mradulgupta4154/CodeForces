#include <iostream>
#include <algorithm>
#include <cmath>
using namespace std;
 
int main() {
    int a;
    cin>>a;
    while(a--){
        string c;
        cin>>c;
        string ans="";
        for(int i =0;i<c.length();i++){
            ans+=tolower(c[i]);
        }
        if(ans=="yes") cout<<"YES"<<endl;
        else cout<<"NO"<<endl;
    }
    
    return 0;
    
}